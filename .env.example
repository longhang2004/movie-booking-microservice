# Copy to .env before docker compose up
# cp .env.example .env

POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_DB=postgres

JWT_ISSUER=movie-booking
JWT_AUDIENCE=movie-booking-api
JWT_JWK_SET_URI=http://localhost:8096/auth/.well-known/jwks.json
JWT_EXPIRATION_SECONDS=3600
# Compose mounts docker/jwt/*.pem into auth-service. Rotate with FORCE=1 bash scripts/generate-jwt-keys.sh
JWT_PRIVATE_KEY_LOCATION=/keys/private.pem
JWT_PUBLIC_KEY_LOCATION=/keys/public.pem

REDIS_HOST=redis
KAFKA_BOOTSTRAP=kafka:9092
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
